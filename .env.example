# Connect → .env.local (lokal). Vercel-də eyni adlarla Environment Variables.
#
# Vacib: qonaq elan görə bilməsi üçün Legacy anon JWT istifadə et (eyJ… ilə başlayır).
# Supabase → Project Settings → API Keys → Legacy anon public.
# Publishable (sb_publishable_…) tək başına guest feed-i boş buraxa bilər.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production canonical URL (Vercel-də https://kirayesin.az). Boş qalsa VERCEL_URL və ya default istifadə olunur.
NEXT_PUBLIC_SITE_URL=

# Google Search Console → HTML tag verification (meta content dəyəri, tam tag yox).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Məhsul limitləri: boş və ya 0 = limitsiz. Gələcəkdə məs: 1 və 5
PRODUCT_MAX_ACTIVE_LISTINGS=
PRODUCT_NEW_CHATS_PER_DAY=

# Vercel Cron: /api/cron/expire-listings (vercel.json). Uzun random string yaz.
# Misal: openssl rand -hex 24
CRON_SECRET=
